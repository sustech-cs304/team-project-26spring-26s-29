{
  "name": "kao-hsiao",
  "productName": "Student Productivity Agent",
  "version": "0.0.1",
  "description": "An AI agent app to boost student productivity.",
  "homepage": "https://github.com/sustech-cs304/team-project-26spring-26s-29#readme",
  "bugs": {
    "url": "https://github.com/sustech-cs304/team-project-26spring-26s-29/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sustech-cs304/team-project-26spring-26s-29.git"
  },
  "license": "MIT",
  "author": "Yihao Jiang, Jiayao Qin, Yunzhe Wang, Mingxin Wen, Yiyuan Yuan",
  "type": "commonjs",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "electron .",
    "test:backend": "python -m unittest discover -s tests -v",
    "test:electron": "node --test tests/electron/*.test.js",
    "test": "npm run test:backend && npm run test:electron",
    "package:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron-builder": "^26.0.12",
    "electron": "^41.0.4"
  },
  "build": {
    "appId": "com.studentproductivity.agent",
    "asar": true,
    "files": [
      "src/**/*",
      "backend/**/*",
      "docs/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      },
      {
        "from": "vendor/windows-python",
        "to": "python"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
